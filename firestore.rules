rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Access is controlled by the users collection: a signed-in account whose
    // email has a matching users/{email} document may read/write everything.
    // Manage who's allowed by adding/removing documents there directly in the
    // Firebase console — this rule intentionally has no client write access,
    // so there's no in-app way to self-grant access.
    function isAllowedUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    match /users/{email} {
      allow read: if isAllowedUser();
    }

    match /meals/{mealId} {
      allow read, write: if isAllowedUser();
    }

    match /days/{dayId} {
      allow read, write: if isAllowedUser();
    }

    match /proposals/{proposalId} {
      allow read, write: if isAllowedUser();

      match /items/{itemId} {
        allow read, write: if isAllowedUser();
      }
    }

    // Each person's notifications live under their own uid, but permissions are
    // symmetric — either account can write into either inbox (e.g. to notify
    // the other person of a proposal/agreement).
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if isAllowedUser();
    }
  }
}
